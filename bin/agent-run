#!/usr/bin/env nu

# Run a oneshot task via Pi.
def main [
    --easy                          # use DeepSeek V4 Flash (default)
    --hard                          # use GPT-5.6 Terra
    --continue (-c)                 # continue the last session
    ...prompt: string               # prompt
] {
    let model = if $hard { "openai-codex/gpt-5.6-terra" } else { "deepseek/deepseek-v4-flash" }
    let prompt = ($prompt | str join " ")
    let render = if (which glow | is-empty) { "cat" } else { "glow" }

    let opts = [
        --no-extensions
        --no-skills
        --no-context-files
        --extension npm:pi-mcp-adapter
        --extension npm:pi-web-access
        --model $model
        --session-dir ~/.local/share/pi/agent-run-sessions
        --append-system-prompt (open --raw ~/.agents/agents/pragmatic-oneshot.md)
        --name $"[oneshot] ($prompt)"
        --print
        ...(if $continue { ["--continue"] } else { [] })
    ]

    ^pi ...$opts -- $prompt | ^$render
}
