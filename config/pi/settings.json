{
  "lastChangelogVersion": "1.4.0",
  "theme": "nord",
  "defaultProvider": "gilabs",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "medium"
  },
  "httpProxy": "http://127.0.0.1:1080",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false,
  "tuiMode": "fullscreen",
  "treeFilterMode": "no-tools",
  "enabledModels": [
    "kimi-coding/k3-256k",
    "kimi-coding/k3",
    "gilabs/gpt-6.1-sol",
    "gilabs/gpt-6-astra",
    "deepseek/deepseek-flash",
    "deepseek/deepseek-v4-pro"
  ],
  "tidy": {
    "userMessageStyle": "off",
    "finalReplyStyle": "off",
    "frameMessages": false,
    "collapseTurns": "afterRun",
    "groupOpen": true
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@narumitw/pi-usage@0.68.0",
    "npm:pi-open-tui@0.3.11",
    "npm:@tintinweb/pi-subagents@0.23.1",
    "npm:pi-claude-bridge@0.9.3",
    "npm:@diegopetrucci/pi-notify@0.1.19",
    "npm:@yukikisaku/pi-tmux-status@0.2.0",
    "npm:@narumitw/pi-btw@0.62.0",
    "npm:@juicesharp/rpiv-btw@2.15.0",
    "npm:resume-from",
    "npm:@inobit/pi-undo",
    "npm:@heyhuynhgiabuu/pi-diff",
    "npm:pi-background",
    "npm:pi-memory",
    "npm:pi-intercom",
    "npm:@plannotator/pi-extension",
    "npm:pi-simplify",
    "npm:context-mode",
    "npm:pi-context-view",
    "npm:pi-tidy",
    "npm:@spences10/pi-themes"
  ],
  "terminal": {},
  "compaction": {
    "keepRecentTokens": 40000
  }
}