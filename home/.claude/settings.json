{
  "env": {
    "SHELL": "/usr/bin/bash",
    "http_proxy": "http://127.0.0.1:1080",
    "https_proxy": "http://127.0.0.1:1080",
    "HTTP_PROXY": "http://127.0.0.1:1080",
    "HTTPS_PROXY": "http://127.0.0.1:1080",
    "ALL_PROXY": "http://127.0.0.1:1080",
    "all_proxy": "http://127.0.0.1:1080",
    "no_proxy": "localhost,127.0.0.1,.in.silverrainz.me,.tailnet-ecdc.ts.net",
    "NO_PROXY": "localhost,127.0.0.1,.in.silverrainz.me,.tailnet-ecdc.ts.net"
  },
  "permissions": {
    "ask": [
      "Bash(pacman -S*)",
      "Bash(sudo pacman -S*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)",
      "Bash(python -m pip install*)",
      "Bash(uv pip install*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm add*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "crit@crit": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Installing system or language packages (pacman/pip/npm and similar, e.g. pacman -S, pip install, npm install/add) — always require user approval"
    ]
  }
}
